# ─────────────────────────────────────────────────────────────────
# Japam — environment variables
# Copy to .env.local for local dev. Set the same names in Vercel
# → Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────

# Firebase (frontend) — from Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (server) — Firebase Console → Project Settings → Service accounts → Generate new private key.
# Paste the whole JSON as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cashfree (PG) — https://merchant.cashfree.com/merchants/pg/developers/api-keys
CASHFREE_APP_ID=
CASHFREE_SECRET=
# Leave blank or set "production" for live; "sandbox" for testing.
CASHFREE_ENV=production

# Cashfree webhooks — two ways, pick whichever your dashboard offers:
#
#   A) GLOBAL ENDPOINT  (Dashboard → Developers → Webhooks → Add endpoint)
#      URL:    https://japam.digital/api/cashfree-webhook
#      Events: PAYMENT_SUCCESS_WEBHOOK (optional: PAYMENT_FAILED_WEBHOOK)
#      Version: 2023-08-01
#
#   B) NOTIFY_URL POLICY (Dashboard shows a "NOTIFY_URL" row with "Policy 1:
#      DEFAULT / success payment"). In this mode Cashfree calls whatever
#      notify_url we pass in `order_meta` when creating the order. We now pass
#      this automatically — just set the URL below so dev origins don't leak.
CASHFREE_NOTIFY_URL=https://japam.digital/api/cashfree-webhook
# Webhook signing secret. Leave blank if Cashfree didn't show a separate one
# — the code falls back to CASHFREE_SECRET which is correct for most accounts.
CASHFREE_WEBHOOK_SECRET=

# Admin login + JWT signing
ADMIN_ID=
ADMIN_PASSWORD=
# Min 32 random chars. Use `openssl rand -hex 32` to generate.
ADMIN_SECRET=
# Optional — defaults to ADMIN_SECRET if unset.
PRIEST_SECRET=

# Cron jobs — set this even though Vercel injects one for built-in crons.
CRON_SECRET=

# Daily japa reminder Web Push (alarm when app is closed). Generate keys:
#   node scripts/generate-vapid-keys.mjs
# Set VAPID_PUBLIC_KEY in Vercel AND VITE_VAPID_PUBLIC_KEY to the same public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:support@japam.digital

# CORS — comma-separated, no spaces, no trailing slashes.
CORS_ORIGINS=https://japam.digital,https://www.japam.digital
# Leave unset in prod. Set to "true" only if you also hit preview URLs.
# CORS_ALLOW_VERCEL_PREVIEWS=false

# Distributed rate limits (strongly recommended for production).
# Sign up at https://upstash.com (free tier is enough), create a Redis
# database, copy the REST URL + REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error tracking (optional but recommended).
# Frontend DSN — exposed in the browser by design.
VITE_SENTRY_DSN=
# Server DSN — can be the same project DSN as frontend, or a separate one.
SENTRY_DSN=

# Firebase App Check (reCAPTCHA v3) — blocks bots from your Firestore quota.
# Get site key from https://www.google.com/recaptcha/admin (add japam.digital).
VITE_RECAPTCHA_SITE_KEY=
# Dev only — debug token for local App Check. Never set in production.
# VITE_APP_CHECK_DEBUG_TOKEN=

# Persist audit logs to Firestore (coupon rejections, admin logins, webhooks, etc.)
AUDIT_TO_FIRESTORE=true

# Backend API URL (frontend). Leave empty on Vercel for same-origin /api.
# Local dev: http://localhost:3001 when running the Express server in ./server.
VITE_API_URL=

# Apavarga community app URL. Same-origin in production (/apavarga).
# For local dev: http://localhost:5174.
VITE_APAVARGA_URL=

# Feature flags — off by default. Enable only when the underlying feature is ready.
# VITE_LAUNCH_MULTIPLAYER_ASURA=true
# VITE_LAUNCH_OCCASION_GAMES=true
# Client debug logs via localStorage — do NOT enable in production builds.
# VITE_ENABLE_GAME_DEBUG=true
