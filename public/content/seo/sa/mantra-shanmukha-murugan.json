      "runs": [
        {
          "text": "भगवान् मुरुगनः (शन्मुखः, सुब्रह्मण्यः, स्कन्धः) तमिलः, सर्वभारतीयः च साहसस्य, प्रज्ञायाः च देवः अस्ति । तस्य मन्त्रः स्कन्दशास्त्रस्य, थाई पूसमस्य च केन्द्रम् अस्ति ।"
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "जपम् दैनिकजपस्य प्रामाणिकमन्त्रश्रव्यसहितं मुरुगनं समावेशयति।"
        }
      ]
    },
    {
      "type": "h2",
      "text": "मन्त्रार्थः"
