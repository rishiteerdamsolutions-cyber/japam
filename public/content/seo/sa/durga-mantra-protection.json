    },
    {
      "type": "h2",
      "text": "कदा जपेत्"
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "नवरात्रि तथा मंगलवार; नवरात्रिकाले मार्गदर्शनेन गोलानि वर्धयन्तु।"
        }
      ]
    },
    {
      "type": "h2",
      "text": "१०८ पुनरावृत्तयः किमर्थं महत्त्वपूर्णाः सन्ति",
