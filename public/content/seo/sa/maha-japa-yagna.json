    },
    {
      "type": "p",
      "runs": [
        {
          "text": "१०८ संख्या जपमाले एकः पूर्णगोलः अस्ति । नित्यपुनरावृत्तिः मनः शान्तं करोति, मन्त्रस्य अर्थे ध्यानं गभीरं करोति च ।"
        }
      ]
    },
    {
      "type": "p",
      "runs": [
        {
          "text": "केचन परम्पराः ११ वा २१ वा मालाः विहिताः सन्ति — भवतः गुरुं वा पुरोहितं वा भवतः व्रतस्य अनुकूलानि गणनानि पृच्छन्तु ।"
        }
      ]
    },
    {
      "type": "h2",
      "text": "परिहरणीयानि सामान्यानि त्रुटयः"
